{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skying",
  "main": "worker.js",
  "compatibility_date": "2026-09-16",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/sunset-forecast", "/sunset-forecast/*", "/forecast", "/forecast/*"]
  }
}
