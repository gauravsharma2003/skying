{
  "name": "skying",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test",
    "deploy": "npm run check && wrangler deploy",
    "audit:live": "node scripts/audit-live.mjs",
    "audit:lighthouse": "lighthouse http://127.0.0.1:8787/sunset-forecast/new-delhi-india --chrome-flags=\"--headless\" --only-categories=performance,accessibility,best-practices,seo --output=html --output-path=reports/lighthouse.html"
  },
  "dependencies": {
    "suncalc": "1.9.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lighthouse": "13.4.1",
    "sharp": "0.35.4",
    "wrangler": "4.133.0"
  }
}
